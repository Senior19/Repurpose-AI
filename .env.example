# Copy to .env locally and fill in only the provider you use.
# Never commit a real .env file or API key.

GROQ_API_KEY=
ANTHROPIC_API_KEY=
REPURPOSEAI_PROVIDER=groq
# Optional: choose a model supported by your provider.
REPURPOSEAI_MODEL=

# Leave blank for same-origin hosting. For a separately hosted frontend,
# use a comma-separated list of exact trusted origins.
REPURPOSEAI_CORS_ORIGINS=

# Optional path for the SQLite runtime database.
# REPURPOSEAI_DB_PATH=./repurposeai.db
